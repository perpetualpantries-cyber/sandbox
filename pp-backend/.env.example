DATABASE_URL=postgres://pp:pp@localhost:5432/pp
JWT_SECRET=change-me-to-a-long-random-string
BACKUP_KEY=change-me-separately-this-encrypts-site-backups
PORT=8080
CORS_ORIGINS=*

# Server-managed auto-send POs (see migrations/003_scheduled_pos.sql)
CRON_SECRET=change-me-to-a-long-random-string
RESEND_API_KEY=
RESEND_FROM_EMAIL=orders@yourdomain.com
# Set during a soak test to redirect every auto-send PO email to one inbox
# instead of the real supplier. Leave unset in production.
PO_EMAIL_TEST_REDIRECT=
